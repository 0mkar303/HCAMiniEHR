@page
@model HCAMiniEHR.Pages.Patients.CreateModel

<h2>Add Patient</h2>

<form method="post">
    <div>
        <label>Full Name</label>
        <input asp-for="Patient.FullName" />
    </div>

    <div>
        <label>Date of Birth</label>
        <input asp-for="Patient.DOB" type="date" />
    </div>

    <div>
        <label>Gender</label>
        <input asp-for="Patient.Gender" />
    </div>

    <button type="submit">Save</button>
</form>
