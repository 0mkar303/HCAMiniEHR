@page
@model HCAMiniEHR.Pages.Patients.IndexModel

<div class="container mt-4">

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row
                justify-content-between align-items-start align-items-md-center mb-3">
        <h3 class="mb-2 mb-md-0">Patients</h3>

        <a asp-page="Create" class="btn btn-primary">
            + Add Patient
        </a>
    </div>

    <!-- Desktop / Tablet Table -->
    <div class="table-responsive d-none d-md-block">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Full Name</th>
                    <th>Mobile</th>
                    <th style="width: 40%">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Patients)
                {
                    <tr>
                        <td>@p.FullName</td>
                        <td>@p.MobileNumber</td>
                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                <a asp-page="Edit"
                                   asp-route-id="@p.PatientId"
                                   class="btn btn-sm btn-warning">
                                    Edit
                                </a>

                                <a asp-page="Delete"
                                   asp-route-id="@p.PatientId"
                                   class="btn btn-sm btn-danger">
                                    Delete
                                </a>

                                <a asp-page="/Appointments/Index"
                                   asp-route-patientId="@p.PatientId"
                                   class="btn btn-sm btn-info text-white">
                                    Appointments
                                </a>

                                <a asp-page="/Appointments/Create"
                                   asp-route-patientId="@p.PatientId"
                                   class="btn btn-sm btn-success">
                                    + Appointment
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Mobile View (Cards) -->
    <div class="d-md-none">
        @foreach (var p in Model.Patients)
        {
            <div class="card mb-3 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-1">@p.FullName</h5>
                    <p class="text-muted mb-2">
                        📞 @p.MobileNumber
                    </p>

                    <div class="d-grid gap-2">
                        <a asp-page="Edit"
                           asp-route-id="@p.PatientId"
                           class="btn btn-outline-warning btn-sm">
                            Edit
                        </a>

                        <a asp-page="Delete"
                           asp-route-id="@p.PatientId"
                           class="btn btn-outline-danger btn-sm">
                            Delete
                        </a>

                        <a asp-page="/Appointments/Index"
                           asp-route-patientId="@p.PatientId"
                           class="btn btn-outline-info btn-sm">
                            View Appointments
                        </a>

                        <a asp-page="/Appointments/Create"
                           asp-route-patientId="@p.PatientId"
                           class="btn btn-outline-success btn-sm">
                            Add Appointment
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

</div>
