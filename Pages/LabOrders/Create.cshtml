@page
@model HCAMiniEHR.Pages.LabOrders.CreateModel

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Add Lab Order</h4>
                </div>

                <div class="card-body">

                    <!-- Validation summary -->
                    <div asp-validation-summary="All"
                         class="alert alert-danger"></div>

                    <form method="post">

                        <!-- 🔥 REQUIRED -->
                        <input type="hidden"
                               asp-for="LabOrder.AppointmentId" />

                        <div class="mb-3">
                            <label class="form-label">
                                Test Name <span class="text-danger">*</span>
                            </label>

                           @*  <select asp-for="LabOrder.TestName"
                                    asp-items="Model.TestList"
                                    class="form-select">
                                <option value="">-- Select Test --</option>
                            </select> *@
                            <div class="mb-3">
                                @* <label class="form-label">
                                    Test Name <span class="text-danger">*</span>
                                </label> *@

                                <input asp-for="LabOrder.TestName"
                                       class="form-control"
                                       list="testList"
                                       placeholder="Select or type test name" />

                                <datalist id="testList">
                                    @foreach (var test in Model.TestList)
                                    {
                                        <option value="@test.Text"></option>
                                    }
                                </datalist>

                                <span asp-validation-for="LabOrder.TestName"
                                      class="text-danger"></span>
                            </div>


                            <span asp-validation-for="LabOrder.TestName"
                                  class="text-danger"></span>
                        </div>


                        <div class="d-flex justify-content-end gap-2">
                            <a asp-page="Index"
                               asp-route-appointmentId="@Model.LabOrder.AppointmentId"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-success">
                                Save
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
