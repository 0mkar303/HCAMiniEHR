@page
@model HCAMiniEHR.Pages.Reports.PatientsWithoutFollowUpModel

<h2>Patients Without Follow-Up</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Gender</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model.Patients)
        {
            <tr>
                <td>@p.FullName</td>
                <td>@p.Gender</td>
            </tr>
        }
    </tbody>
</table>
