@page
@model HCAMiniEHR.Pages.Reports.PendingLabs

<h2>Pending Lab Orders</h2>

<table class="table table-striped">
    <tr>
        <th>Patient</th>
        <th>Test</th>
    </tr>
    @foreach (var r in Model.Report)
    {
        <tr>
            <td>@r.PatientName</td>
            <td>@r.TestName</td>
        </tr>
    }
</table>
