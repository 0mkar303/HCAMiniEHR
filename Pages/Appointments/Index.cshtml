@page
@model HCAMiniEHR.Pages.Appointments.IndexModel

<h2>Appointments</h2>

<a asp-page="Create"
   asp-route-patientId="@Model.PatientId"
   class="btn btn-primary mb-2">
    Add Appointment
</a>

<table class="table table-bordered">
    <tr>
        <th>Date</th>
        <th>Status</th>
        <th>Doctor</th>
    </tr>

    @foreach (var a in Model.Appointments)
    {
        <tr>
            <td>@a.AppointmentDate.ToShortDateString()</td>
            <td>@a.Status</td>
            <td>@a.Doctor?.FullName</td>
        </tr>
    }
</table>
